{
  "expo": {
    "name": "iFujao",
    "slug": "ifujao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_bg.png",
    "scheme": "ifujao",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ifujao.app"
    },
    "android": {
        "adaptiveIcon": {
          "backgroundColor": "#D3D3D3",
          "foregroundImage": "./assets/images/logo.png"
        },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ifujao.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "O iFujão precisa de acesso à sua câmera para registrar pets perdidos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O iFujão precisa da sua localização para mostrar o mapa e encontrar pets perdidos perto de você."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
